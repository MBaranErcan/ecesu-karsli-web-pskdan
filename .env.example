# =============================================================================
# Ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
#   cp .env.example .env.local
# =============================================================================

# Sitenin yayınlandığı tam adres (sonunda / olmadan).
# Canonical URL, hreflang, sitemap ve OG etiketleri bu değere göre üretilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Supabase panelinde: Project Settings → API

# Proje URL'i (tarayıcıya da gönderilir)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public anahtarı (tarayıcıya da gönderilir; RLS ile korunur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role anahtarı — YALNIZCA sunucu tarafında kullanılır.
# Bu anahtar RLS'i atlar; asla istemciye gönderilmemeli, repoya eklenmemelidir.
SUPABASE_SERVICE_ROLE_KEY=

# Görsellerin yükleneceği Storage bucket adı (0003_storage.sql ile oluşturulur)
SUPABASE_STORAGE_BUCKET=media

# --- Analytics ---------------------------------------------------------------
# Gizlilik dostu ölçümleme etkinleştirilecekse true yapın (varsayılan: kapalı)
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Plausible benzeri, çerezsiz bir ölçümleme kullanılacaksa doldurun.
# Boş bırakılırsa hiçbir üçüncü taraf script yüklenmez.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
